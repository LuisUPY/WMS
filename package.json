{
  "name": "wms-inventory",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test tests/auth.test.mjs tests/access-policy.test.mjs tests/inventory.test.mjs",
    "test:browser": "node tests/login.browser.cjs && node tests/inventory.browser.cjs",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-wms-inventory \"node --test tests/firestore.test.mjs\"",
    "inventory:check": "node scripts/inventory-import.mjs",
    "inventory:import": "node scripts/inventory-import.mjs --apply",
    "auth:status": "node scripts/auth-status.mjs",
    "admin:grant": "node scripts/admin-role.mjs grant",
    "admin:revoke": "node scripts/admin-role.mjs revoke"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "firebase-admin": "^13.0.0" },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.0.0"
  }
}
