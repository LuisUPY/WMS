rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function administrator() {
      return request.auth != null
        && request.auth.token.admin == true
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function approved() {
      let s = get(/databases/$(database)/documents/settings/inventory).data;
      let a = s.approval;
      return s.status == 'active' && s.approvalStatus == 'approved' && s.stockScope == 'all-usable'
        && s.approvalId is string && s.approvalId.matches('^[a-f0-9]{64}$')
        && a.schemaVersion == 1 && a.stockScope == s.stockScope
        && a.sourceSha256 is string && a.sourceSha256.matches('^[a-f0-9]{64}$')
        && a.sourceSha256 == s.sourceSha256
        && a.inventorySha256 is string && a.inventorySha256.matches('^[a-f0-9]{64}$')
        && a.recordCount is int && a.recordCount > 0 && a.recordCount <= 400 && a.recordCount == s.recordCount
        && a.sourceAsOf is timestamp && a.sourceAsOf == s.sourceAsOf
        && a.approvedAt is timestamp && a.sourceAsOf <= a.approvedAt && a.approvedAt <= request.time
        && a.approvedBy is string && a.approvedBy.size() <= 120 && a.approvedBy.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && a.approvedByUid is string && a.approvedByUid.size() <= 128 && a.approvedByUid.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && a.evidence is string && a.evidence.size() <= 1000 && a.evidence.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && a.quantitiesAndUnitsConfirmed == true && a.numericNormalizationsReviewed == true
        && a.noUnrecordedMovementsConfirmed == true
        && get(/databases/$(database)/documents/inventoryApprovals/$(s.approvalId)).data.approval == a;
    }
    function validMovement(m) {
      return m.keys().hasOnly(['itemId', 'type', 'quantity', 'reference', 'unit', 'sku', 'warehouse',
        'stockBefore', 'stockAfter', 'actorUid', 'createdAt'])
        && m.keys().hasAll(['itemId', 'type', 'quantity', 'reference', 'unit', 'sku', 'warehouse',
        'stockBefore', 'stockAfter', 'actorUid', 'createdAt'])
        && m.itemId is string && m.itemId.matches('^[A-Z0-9]+__[0-9]{1,20}$')
        && m.type in ['entry', 'exit']
        && m.quantity is int && m.quantity > 0 && m.quantity <= 1000000000
        && m.reference is string && m.reference.size() > 0 && m.reference.size() <= 160
        && m.reference.matches('.*[^\\s].*')
        && m.actorUid == request.auth.uid && m.createdAt == request.time
        && m.stockBefore is int && m.stockBefore >= 0
        && m.stockAfter is int && m.stockAfter >= 0 && m.stockAfter <= 9007199254740991
        && ((m.type == 'entry' && m.stockAfter == m.stockBefore + m.quantity)
          || (m.type == 'exit' && m.stockAfter == m.stockBefore - m.quantity));
    }
    match /settings/inventory {
      allow read: if administrator();
      // Import and opening approval are restricted to the trusted Admin SDK.
      allow write: if false;
    }
    match /inventoryApprovals/{approvalId} {
      allow read: if administrator();
      allow write: if false;
    }
    function validDetailChange(c) {
      return c.keys().hasOnly(['itemId', 'field', 'valueBefore', 'valueAfter', 'revisionBefore', 'revisionAfter', 'actorUid', 'createdAt'])
        && c.keys().hasAll(['itemId', 'field', 'valueBefore', 'valueAfter', 'revisionBefore', 'revisionAfter', 'actorUid', 'createdAt'])
        && c.itemId is string && c.itemId.matches('^[A-Z0-9]+__[0-9]{1,20}$')
        && ((c.field in ['umr', 'location'] && c.valueBefore is string && c.valueAfter is string
          && c.valueAfter.size() > 0 && c.valueAfter.size() <= (c.field == 'umr' ? 20 : 80)
          && c.valueAfter.matches('.*[^\\s].*'))
          || (c.field in ['cs', 'car', 'cxt'] && c.valueBefore is int && c.valueAfter is int
            && c.valueAfter >= 0 && c.valueAfter <= 1000000000))
        && c.revisionBefore is int && c.revisionBefore >= 0 && c.revisionBefore < 9007199254740991
        && c.revisionAfter is int && c.revisionAfter == c.revisionBefore + 1
        && c.actorUid == request.auth.uid && c.createdAt == request.time;
    }
    function pairedDetail(itemId, next, c, changeId) {
      let path = /databases/$(database)/documents/inventoryDetails/$(itemId);
      let item = get(/databases/$(database)/documents/inventory/$(itemId)).data;
      let before = exists(path) ? get(path).data : {'umr': item.unit, 'location': item.warehouse, 'revision': 0};
      let values = {'umr': before.umr, 'location': before.location,
        'cs': before.get('cs', item.openingPackages.cs), 'car': before.get('car', item.openingPackages.car),
        'cxt': before.get('cxt', item.openingPackages.cxt)};
      return next.keys().hasOnly(['itemId', 'umr', 'location', 'cs', 'car', 'cxt', 'revision', 'lastChangeId', 'updatedAt'])
        && next.keys().hasAll(['itemId', 'umr', 'location', 'cs', 'car', 'cxt', 'revision', 'lastChangeId', 'updatedAt'])
        && next.itemId == itemId && c.itemId == itemId
        && c.valueBefore == values[c.field] && c.revisionBefore == before.revision
        && next.umr == (c.field == 'umr' ? c.valueAfter : values.umr)
        && next.location == (c.field == 'location' ? c.valueAfter : values.location)
        && next.cs == (c.field == 'cs' ? c.valueAfter : values.cs)
        && next.car == (c.field == 'car' ? c.valueAfter : values.car)
        && next.cxt == (c.field == 'cxt' ? c.valueAfter : values.cxt)
        && next.revision == c.revisionAfter && next.lastChangeId == changeId && next.updatedAt == request.time;
    }
    match /inventoryDetails/{itemId} {
      allow read: if administrator();
      allow delete: if false;
      allow create, update: if administrator() && validDetailWrite(itemId);
      function validDetailWrite(itemId) {
        let next = request.resource.data;
        return next.keys().hasAny(['operationId']) ? validOperationDetailWrite(itemId, next) : approved() && validLegacyDetailWrite(itemId, next);
      }
      function validLegacyDetailWrite(itemId, next) {
        let path = /databases/$(database)/documents/inventoryDetailChanges/$(next.lastChangeId);
        let change = getAfter(path).data;
        return next.lastChangeId is string && next.lastChangeId.matches('^[a-zA-Z0-9-]{20,80}$')
          && !exists(path) && validDetailChange(change) && pairedDetail(itemId, next, change, next.lastChangeId);
      }
    }
    function operationHeader(o) {
      return o.keys().hasOnly(['reference', 'lines', 'actorUid', 'createdAt'])
        && o.keys().hasAll(['reference', 'lines', 'actorUid', 'createdAt'])
        && o.reference is string && o.reference.size() > 0 && o.reference.size() <= 160 && o.reference.matches('.*[^\\s].*')
        && o.actorUid == request.auth.uid && o.createdAt == request.time
        && o.lines is map && o.lines.size() >= 1 && o.lines.size() <= 5;
    }
    function operationStock(itemId, l, operationId) {
      let path = /databases/$(database)/documents/inventory/$(itemId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return l.keys().hasOnly(['type', 'quantity', 'sku', 'unit', 'warehouse', 'stockBefore', 'stockAfter', 'revisionBefore', 'revisionAfter'])
        && l.keys().hasAll(['type', 'quantity', 'sku', 'unit', 'warehouse', 'stockBefore', 'stockAfter', 'revisionBefore', 'revisionAfter'])
        && l.type in ['entry', 'exit'] && l.quantity is int && l.quantity > 0 && l.quantity <= 1000000000
        && l.sku == before.sku && l.unit == before.unit && l.warehouse == before.warehouse
        && l.stockBefore == before.stock && l.stockAfter is int && l.stockAfter >= 0 && l.stockAfter <= 9007199254740991
        && ((l.type == 'entry' && l.stockAfter == l.stockBefore + l.quantity)
          || (l.type == 'exit' && l.stockAfter == l.stockBefore - l.quantity))
        && l.revisionBefore == before.revision && l.revisionAfter == before.revision + 1
        && after.diff(before).affectedKeys().hasOnly(['stock', 'revision', 'lastMovementId', 'lastOperationId', 'updatedAt'])
        && after.stock == l.stockAfter && after.revision == l.revisionAfter && after.updatedAt == request.time
        && after.lastMovementId == operationId && after.lastOperationId == operationId;
    }
    function operationPackages(itemId, l, operationId) {
      let path = /databases/$(database)/documents/inventoryDetails/$(itemId);
      let item = get(/databases/$(database)/documents/inventory/$(itemId)).data;
      let before = exists(path) ? get(path).data : {'umr': item.unit, 'location': item.warehouse, 'revision': 0};
      let packages = {'cs': before.get('cs', item.openingPackages.cs), 'car': before.get('car', item.openingPackages.car),
        'cxt': before.get('cxt', item.openingPackages.cxt)};
      let after = getAfter(path).data;
      return l.keys().hasOnly(['type', 'packagesBefore', 'packagesAfter', 'revisionBefore', 'revisionAfter'])
        && l.keys().hasAll(['type', 'packagesBefore', 'packagesAfter', 'revisionBefore', 'revisionAfter'])
        && l.type == 'packages' && l.packagesBefore == packages && validPackages(l.packagesAfter)
        && l.revisionBefore == before.revision && l.revisionAfter == before.revision + 1
        && after.keys().hasOnly(['itemId', 'umr', 'location', 'cs', 'car', 'cxt', 'revision', 'lastChangeId', 'operationId', 'updatedAt'])
        && after.keys().hasAll(['itemId', 'umr', 'location', 'cs', 'car', 'cxt', 'revision', 'lastChangeId', 'operationId', 'updatedAt'])
        && after.itemId == itemId && after.umr == before.umr && after.location == before.location
        && after.cs == l.packagesAfter.cs && after.car == l.packagesAfter.car && after.cxt == l.packagesAfter.cxt
        && after.revision == l.revisionAfter && after.lastChangeId == operationId && after.operationId == operationId
        && after.updatedAt == request.time;
    }
    function validPackages(p) {
      return p is map && p.keys().hasOnly(['cs', 'car', 'cxt']) && p.keys().hasAll(['cs', 'car', 'cxt'])
        && p.cs is int && p.cs >= 0 && p.cs <= 1000000000
        && p.car is int && p.car >= 0 && p.car <= 1000000000
        && p.cxt is int && p.cxt >= 0 && p.cxt <= 1000000000;
    }
    function operationLine(o, operationId, index) {
      let itemId = o.lines.keys()[index];
      let l = o.lines[itemId];
      return itemId.matches('^[A-Z0-9]+__[0-9]{1,20}$')
        && (l.type == 'packages' ? packageWitness(itemId, operationId)
          : l.type in ['entry', 'exit'] && stockWitness(itemId, operationId));
    }
    function stockWitness(itemId, operationId) {
      let after = getAfter(/databases/$(database)/documents/inventory/$(itemId)).data;
      return after.lastMovementId == operationId && after.lastOperationId == operationId && after.updatedAt == request.time;
    }
    function packageWitness(itemId, operationId) {
      let after = getAfter(/databases/$(database)/documents/inventoryDetails/$(itemId)).data;
      return after.lastChangeId == operationId && after.operationId == operationId && after.updatedAt == request.time;
    }
    function validOperationDetailWrite(itemId, next) {
      let path = /databases/$(database)/documents/operations/$(next.operationId);
      let o = getAfter(path).data;
      // The operation checks a fresh witness for every line. Each leaf checks
      // its full before/after pair, keeping evaluation bounded per document.
      return !exists(path) && o.actorUid == request.auth.uid && o.createdAt == request.time
        && operationPackages(itemId, o.lines[itemId], next.operationId);
    }
    function validOperationStockWrite(itemId, next) {
      let path = /databases/$(database)/documents/operations/$(next.lastOperationId);
      let o = getAfter(path).data;
      return !exists(path) && o.actorUid == request.auth.uid && o.createdAt == request.time
        && operationStock(itemId, o.lines[itemId], next.lastOperationId);
    }
    match /operations/{operationId} {
      allow read: if administrator();
      allow update, delete: if false;
      allow create: if administrator() && approved() && operationId.matches('^[a-zA-Z0-9-]{20,80}$')
        && operationHeader(request.resource.data)
        && operationLine(request.resource.data, operationId, 0)
        && (request.resource.data.lines.size() < 2 || operationLine(request.resource.data, operationId, 1))
        && (request.resource.data.lines.size() < 3 || operationLine(request.resource.data, operationId, 2))
        && (request.resource.data.lines.size() < 4 || operationLine(request.resource.data, operationId, 3))
        && (request.resource.data.lines.size() < 5 || operationLine(request.resource.data, operationId, 4));
    }
    match /inventoryDetailChanges/{changeId} {
      allow read: if administrator();
      allow update, delete: if false;
      allow create: if administrator() && approved() && changeId.matches('^[a-zA-Z0-9-]{20,80}$')
        && validDetailChange(request.resource.data)
        && pairedDetail(request.resource.data.itemId,
          getAfter(/databases/$(database)/documents/inventoryDetails/$(request.resource.data.itemId)).data,
          request.resource.data, changeId);
    }
    match /inventory/{itemId} {
      allow read: if administrator();
      allow create, delete: if false;
      allow update: if administrator() && validStockUpdate(itemId);

      function validStockUpdate(itemId) {
        let next = request.resource.data;
        return next.get('lastOperationId', '') == next.lastMovementId ? validOperationStockWrite(itemId, next) : approved() && validLegacyStockUpdate(itemId, next);
      }
      function validLegacyStockUpdate(itemId, next) {
        let movementPath = /databases/$(database)/documents/movements/$(next.lastMovementId);
        let movement = getAfter(movementPath).data;
        return next.diff(resource.data).affectedKeys().hasOnly(['stock', 'revision', 'lastMovementId', 'updatedAt'])
          && next.lastMovementId is string && next.lastMovementId.matches('^[a-zA-Z0-9-]{20,80}$')
          && !exists(movementPath)
          && validMovement(movement)
          && movement.itemId == itemId && movement.sku == resource.data.sku
          && movement.warehouse == resource.data.warehouse && movement.unit == resource.data.unit
          && movement.stockBefore == resource.data.stock && movement.stockAfter == next.stock
          && next.revision is int && next.revision == resource.data.revision + 1 && next.updatedAt == request.time;
      }
    }
    match /movements/{movementId} {
      allow read: if administrator();
      allow update, delete: if false;
      allow create: if administrator() && approved()
        && movementId.matches('^[a-zA-Z0-9-]{20,80}$')
        && validMovement(request.resource.data)
        && pairedStockUpdate(request.resource.data, movementId);

      function pairedStockUpdate(m, movementId) {
        let path = /databases/$(database)/documents/inventory/$(m.itemId);
        let before = get(path).data;
        let after = getAfter(path).data;
        return before.stock == m.stockBefore && after.stock == m.stockAfter
          && after.lastMovementId == movementId && after.revision == before.revision + 1
          && after.updatedAt == request.time
          && before.sku == m.sku && before.warehouse == m.warehouse && before.unit == m.unit;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
